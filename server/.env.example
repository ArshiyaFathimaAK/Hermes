# Copy to server/.env and fill in. .env is never committed. These stay on the server:
# never copy a key into the app, where anyone could read it.

# GOOGLE_PLACES_API_KEY=
# VIATOR_API_KEY=
# BOOKING_API_KEY=

# Generate AI Itinerary. Without a key, plans come from simple rules instead.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6.2-astra
# OPENAI_REASONING_EFFORT=low

# Web pages allowed to call the server (the Expo web dev server).
# CORS_ORIGINS=["http://localhost:8081"]
