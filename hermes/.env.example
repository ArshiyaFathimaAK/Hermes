# Only needed to run the app on a phone or emulator. Copy this file to .env.local and edit it there.
# .env.local is never committed, and anything set in it replaces the value from .env.

# Where the Python server (../server) is running.
#   Phone with Expo Go:  http://<your computer's Wi-Fi address>:8000. Use the address that
#                        `npx expo start` prints after "Metro: exp://", with :8000 at the end.
#   Android emulator:    http://10.0.2.2:8000
EXPO_PUBLIC_API_URL=http://192.168.1.20:8000
